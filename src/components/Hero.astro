---
import { Picture } from 'astro:assets';
import { hero } from '../data/contenido';
import { proyectos, estadoEtiqueta } from '../data/proyectos';
import WaLink from './WaLink.astro';
import Icon from './Icon.astro';

const total = proyectos.length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="hero field-dark" id="inicio" data-hero aria-labelledby="hero-titulo">
  <span class="plus plus--a" aria-hidden="true">+</span>
  <span class="plus plus--b" aria-hidden="true">+</span>
  <span class="plus plus--c" aria-hidden="true">+</span>

  <div class="container hero__inner">
    <div class="hero__copy">
      <h1 id="hero-titulo" class="hero__h1">
        <span class="eyebrow hero__eyebrow">{hero.etiqueta}</span><span class="sr-only">: </span>
        <span class="hero__title">{hero.titulo}</span>
      </h1>
      <p class="hero__lead">{hero.bajada}</p>
      <div class="hero__actions">
        <a href="#trabajos" class="btn btn--light">Probá una demo <Icon name="flecha" /></a>
        <WaLink origen="hero" class="btn btn--ghost-light">Hablemos por WhatsApp</WaLink>
      </div>
      <dl class="hero__data">
        {hero.datos.map((d) => (
          <div>
            <dt>{d.valor}</dt>
            <dd>{d.texto}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="console" data-carousel aria-roledescription="carrusel" aria-label="Proyectos de Devott" role="region">
      <div class="console__bar">
        <span class="mono console__label">Trabajos</span>
        <div class="console__controls">
          <button type="button" class="ctl" data-prev aria-label="Proyecto anterior"><Icon name="izquierda" size={18} /></button>
          <span class="mono console__count" aria-hidden="true"><span data-current>01</span> / {pad(total)}</span>
          <button type="button" class="ctl" data-next aria-label="Proyecto siguiente"><Icon name="derecha" size={18} /></button>
          <button type="button" class="ctl" data-play aria-label="Pausar el carrusel" aria-pressed="false">
            <svg class="ico-pause" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3h3v10H4zM9 3h3v10H9z" fill="currentColor" /></svg>
            <svg class="ico-play" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5l9 5.5-9 5.5z" fill="currentColor" /></svg>
          </button>
        </div>
      </div>

      <div class="console__track" data-track>
        {proyectos.map((p, i) => (
          <div
            class="slide"
            role="group"
            aria-roledescription="diapositiva"
            aria-label={`${i + 1} de ${total}: ${p.nombre}`}
          >
            <div class="slide__screen">
              {p.capturas ? (
                <>
                  <Picture
                    src={p.capturas.desktop}
                    formats={['avif', 'webp']}
                    widths={[720, 1080, 1440]}
                    sizes="(min-width: 1080px) 760px, 1px"
                    alt={`Página de ${p.nombre} vista en computadora`}
                    class="shot shot--desktop"
                    loading="lazy"
                  />
                  <Picture
                    src={p.capturas.mobile}
                    formats={['avif', 'webp']}
                    widths={[300, 390, 600, 780]}
                    sizes="(min-width: 1080px) 220px, (min-width: 640px) 300px, 70vw"
                    alt={`Página de ${p.nombre} vista en el celular`}
                    class="shot shot--mobile"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'auto'}
                  />
                </>
              ) : (
                <div class="slide__wip" aria-hidden="true">
                  <span class="mono">En construcción</span>
                  <div class="wip-grid">
                    {Array.from({ length: 6 }).map(() => (
                      <span class="wip-card"><span /><span /><span /></span>
                    ))}
                  </div>
                </div>
              )}
            </div>
            <div class="slide__meta">
              <div>
                <p class="slide__name">{p.nombre}</p>
                <p class="mono slide__rubro">{p.rubro}</p>
              </div>
              <span class:list={['status', `status--${p.estado}`]}>{estadoEtiqueta[p.estado]}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="console__dots" role="group" aria-label="Elegir proyecto">
        {proyectos.map((p, i) => (
          <button type="button" class="dot" data-dot={i} aria-label={`Ver ${p.nombre}`} aria-current={i === 0 ? 'true' : undefined} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: 56px;
    overflow: hidden;
  }

  .plus {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 20px;
    line-height: 1;
    color: rgba(255, 255, 255, 0.55);
    pointer-events: none;
  }

  .plus--a { top: calc(var(--header-h) + 16px); right: 8%; }
  .plus--b { top: 44%; left: 4%; display: none; }
  .plus--c { bottom: 24px; right: 30%; }

  .hero__inner {
    display: grid;
    gap: 48px;
  }

  .hero__eyebrow {
    color: #c4f0ff;
  }

  .hero__h1 {
    display: grid;
    justify-items: start;
    font-weight: inherit;
  }

  .hero__title {
    display: block;
    margin-top: 20px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-hero);
    line-height: 1.02;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .hero__lead {
    margin-top: 20px;
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
  }

  .hero__actions {
    display: grid;
    gap: 12px;
    margin-top: 32px;
  }

  .hero__data {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero__data > div {
    padding: 16px 12px 0 0;
  }

  .hero__data > div + div {
    padding-left: 12px;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
  }

  .hero__data dt {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 500;
    line-height: 1;
  }

  .hero__data dd {
    margin-top: 6px;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Consola / carrusel */
  .console {
    border: 1px solid rgba(196, 240, 255, 0.45);
    border-radius: var(--radius);
    background: rgba(9, 35, 79, 0.6);
    min-width: 0;
  }

  .console__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 8px 8px 16px;
    border-bottom: 1px solid rgba(196, 240, 255, 0.3);
    font-size: 0.8125rem;
    color: #c4f0ff;
  }

  .console__controls {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .console__count {
    min-width: 64px;
    text-align: center;
    color: #ffffff;
  }

  .ctl {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    color: #ffffff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .ctl:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  .ico-play { display: none; }
  .ctl[aria-pressed='true'] .ico-play { display: block; }
  .ctl[aria-pressed='true'] .ico-pause { display: none; }

  .console__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .console__track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-width: 0;
  }

  .slide__screen {
    position: relative;
    display: grid;
    place-items: center;
    height: clamp(380px, 112vw, 520px);
    padding: 20px 20px 0;
    overflow: hidden;
    background-color: #384ce3;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .slide__screen :global(picture) {
    display: contents;
  }

  :global(.shot) {
    border: 1px solid rgba(196, 240, 255, 0.7);
    background: #ffffff;
  }

  :global(.shot--desktop) {
    display: none;
  }

  :global(.shot--mobile) {
    align-self: start;
    width: min(78%, 300px);
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .slide__wip {
    align-self: stretch;
    width: 100%;
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 20px;
    border: 1px dashed rgba(255, 255, 255, 0.6);
    border-bottom: 0;
    color: #ffffff;
    font-size: 0.8125rem;
  }

  .wip-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .wip-card {
    display: grid;
    gap: 8px;
    padding: 10px;
    border: 1px solid rgba(255, 255, 255, 0.45);
  }

  .wip-card span {
    height: 8px;
    background: rgba(255, 255, 255, 0.35);
  }

  .wip-card span:first-child {
    height: 48px;
    background: rgba(255, 255, 255, 0.18);
  }

  .wip-card span:last-child {
    width: 60%;
  }

  .slide__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    border-top: 1px solid rgba(196, 240, 255, 0.3);
  }

  .slide__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .slide__rubro {
    margin-top: 4px;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.72);
  }

  .status {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    text-align: left;
    max-width: 12ch;
    line-height: 1.3;
  }

  .status::before {
    content: '';
    flex: none;
    width: 8px;
    height: 8px;
    background: #6ee7a8;
  }

  .status--modelo::before { background: #c4f0ff; }
  .status--en-desarrollo::before { background: #ffd27a; }

  .console__dots {
    display: flex;
    justify-content: center;
    gap: 4px;
    padding: 4px 0 8px;
  }

  .dot {
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    position: relative;
  }

  .dot::after {
    content: '';
    position: absolute;
    left: 6px;
    right: 6px;
    top: 15px;
    height: 2px;
    background: rgba(255, 255, 255, 0.3);
  }

  .dot[aria-current='true']::after {
    background: #ffffff;
  }

  @media (min-width: 560px) {
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 1080px) {
    .hero {
      padding-top: calc(var(--header-h) + 72px);
      padding-bottom: 96px;
    }

    .plus--b {
      display: block;
    }

    .hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: 56px;
    }

    .slide__screen {
      height: 460px;
      place-items: start;
      padding: 28px 28px 0;
    }

    :global(.shot--desktop) {
      display: block;
      width: 88%;
      border-radius: var(--radius) var(--radius) 0 0;
    }

    :global(.shot--mobile) {
      position: absolute;
      right: 24px;
      bottom: -40px;
      width: 190px;
      border-radius: var(--radius);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const current = root.querySelector<HTMLElement>('[data-current]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: number | undefined;
    let paused = reduce;

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[index].offsetLeft - track.offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
    };

    const update = () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      index = Math.max(0, Math.min(slides.length - 1, i));
      current.textContent = String(index + 1).padStart(2, '0');
      dots.forEach((d, n) => (n === index ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      slides.forEach((s, n) => s.setAttribute('aria-hidden', String(n !== index)));
      slides.forEach((s, n) => s.toggleAttribute('inert', n !== index));
    };

    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (!paused) timer = window.setInterval(() => go(index + 1), 6000);
    };
    const setPaused = (p: boolean) => {
      paused = p;
      playBtn.setAttribute('aria-pressed', String(p));
      playBtn.setAttribute('aria-label', p ? 'Reproducir el carrusel' : 'Pausar el carrusel');
      p ? stop() : start();
    };

    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(update);
    });
    root.querySelector('[data-prev]')!.addEventListener('click', () => { go(index - 1); start(); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { go(index + 1); start(); });
    dots.forEach((d, n) => d.addEventListener('click', () => { go(n); start(); }));
    playBtn.addEventListener('click', () => setPaused(!paused));

    // Se detiene mientras la persona lo usa
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    track.addEventListener('touchstart', () => setPaused(true), { passive: true });

    update();
    setPaused(paused);
  });
</script>
