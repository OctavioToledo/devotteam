---
import { Picture } from 'astro:assets';
import { nosotros } from '../data/contenido';
import { equipo, fotoEquipo, videoPresentacion } from '../data/equipo';
import { site } from '../config/site';
import Logo from './Logo.astro';
---

<section class="section" id="nosotros" aria-labelledby="nosotros-titulo">
  <div class="container">
    <div class="mosaico reveal">
      <div class="cell cell--intro">
        <p class="eyebrow">{nosotros.etiqueta}</p>
        <h2 id="nosotros-titulo" class="display">{nosotros.titulo}</h2>
        <p class="lead">{nosotros.bajada}</p>
      </div>

      <figure class="cell cell--foto">
        {fotoEquipo.src ? (
          <Picture
            src={fotoEquipo.src}
            formats={['avif', 'webp']}
            widths={[400, 640, 900, 1086]}
            sizes="(min-width: 900px) 42vw, 100vw"
            alt={fotoEquipo.alt}
            loading="lazy"
          />
        ) : (
          <div class="foto-pendiente">
            <span class="foto-pendiente__plus" aria-hidden="true">+</span>
            <span class="mono">Foto del equipo</span>
            <span class="foto-pendiente__nota">Próximamente</span>
          </div>
        )}
        <figcaption class="mono cell--foto__cap">{fotoEquipo.pie} · {site.ciudad}</figcaption>
      </figure>

      <ul class="cell cell--dupla" aria-label="Equipo">
        {equipo.map((p) => (
          <li class="persona">
            <p class="mono persona__area">{p.area}</p>
            <h3 class="persona__nombre">{p.nombre}</h3>
            <p class="persona__bio">{p.bio}</p>
            {p.link && (
              <a href={p.link.url} target="_blank" rel="noopener" class="link-mono persona__link">
                {p.link.texto}
                <span class="sr-only">de {p.nombre} (se abre en una pestaña nueva)</span>
              </a>
            )}
          </li>
        ))}
      </ul>

      <div class="cell cell--marca">
        <Logo />
        <p class="mono">{site.firma} · {site.bajada} · {site.ciudad}, {site.pais}</p>
      </div>
    </div>

    {videoPresentacion && (
      <div class="video reveal">
        <iframe
          src={videoPresentacion.url}
          title={videoPresentacion.titulo}
          loading="lazy"
          allow="encrypted-media; picture-in-picture"
          allowfullscreen
        />
      </div>
    )}
  </div>
</section>

<style>
  .mosaico {
    display: grid;
    border: 1px solid var(--rule-strong);
  }

  .cell {
    padding: 24px 20px;
    border-bottom: 1px solid var(--rule-strong);
  }

  .cell:last-child {
    border-bottom: 0;
  }

  .cell--intro {
    display: grid;
    gap: 16px;
    align-content: start;
    background: var(--surface);
  }

  .cell--foto {
    position: relative;
    padding: 0;
    aspect-ratio: 3 / 4;
    background: var(--bg-sky);
    overflow: hidden;
  }

  .cell--foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .cell--foto__cap {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 10px 12px;
    background: var(--surface);
    color: var(--text);
    border-top: 1px solid var(--rule-strong);
    border-right: 1px solid var(--rule-strong);
    font-size: 0.75rem;
  }

  .foto-pendiente {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    margin: 16px;
    height: calc(100% - 32px);
    border: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    background-image:
      linear-gradient(color-mix(in srgb, var(--accent) 14%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 14%, transparent) 1px, transparent 1px);
    background-size: 28px 28px;
    font-size: 0.8125rem;
    color: var(--text);
  }

  .foto-pendiente__plus {
    font-family: var(--font-mono);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--accent);
  }

  .foto-pendiente__nota {
    color: var(--muted);
  }

  .cell--dupla {
    display: grid;
    padding: 0;
    background: var(--bg-alt);
  }

  .persona {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 24px 20px;
  }

  .persona + .persona {
    border-top: 1px solid var(--rule-strong);
  }

  .persona__area {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--accent-text);
  }

  .persona__area::before {
    content: '';
    width: 8px;
    height: 8px;
    background: var(--accent);
  }

  .persona__nombre {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2.125rem);
    font-weight: 500;
    line-height: 1.1;
  }

  .persona__bio {
    color: var(--muted);
    max-width: 42ch;
  }

  .persona__link {
    justify-self: start;
    margin-top: 6px;
  }

  .cell--marca {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    background: var(--surface-inverse);
    color: var(--text-inverse);
    font-size: 0.75rem;
    --logo-accent: #8b9bff;
  }

  .cell--marca p {
    opacity: 0.8;
  }

  .video {
    margin-top: 24px;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule-strong);
  }

  .video iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (min-width: 640px) {
    .cell--dupla {
      grid-template-columns: 1fr 1fr;
    }

    .persona + .persona {
      border-top: 0;
      border-left: 1px solid var(--rule-strong);
    }
  }

  @media (min-width: 900px) {
    .mosaico {
      grid-template-columns: 5fr 7fr;
    }

    .cell {
      padding: 40px;
    }

    .cell--foto {
      grid-column: 1;
      grid-row: 1 / 4;
      aspect-ratio: auto;
      min-height: 640px;
      padding: 0;
      border-bottom: 0;
      border-right: 1px solid var(--rule-strong);
    }

    .cell--intro,
    .cell--dupla,
    .cell--marca {
      grid-column: 2;
    }

    .cell--intro {
      align-content: center;
    }

    .cell--dupla {
      padding: 0;
    }

    .persona {
      padding: 32px 40px;
    }

    .cell--marca {
      padding-block: 24px;
    }
  }
</style>
