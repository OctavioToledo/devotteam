---
import { planes } from '../data/contenido';
import { mensajes } from '../config/site';
import Icon from './Icon.astro';
import WaLink from './WaLink.astro';
---

<section class="section section--alt" id="planes" aria-labelledby="planes-titulo">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow reveal">{planes.etiqueta}</p>
      <h2 id="planes-titulo" class="display reveal">{planes.titulo}</h2>
    </div>

    <ul class="planes">
      {planes.items.map((p) => (
        <li class:list={['plan', 'reveal', p.destacado && 'plan--destacado']}>
          {p.destacado && <span class="mono plan__badge">Recomendado para empezar</span>}
          <h3 class="plan__name">{p.nombre}</h3>
          <p class="plan__resumen">{p.resumen}</p>
          <ul class="plan__list">
            {p.incluye.map((x) => (
              <li><Icon name="check" size={18} />{x}</li>
            ))}
          </ul>
          <p class="mono plan__plazo"><span>Plazo</span>{p.plazo}</p>
          <WaLink
            origen="plan"
            detalle={p.nombre}
            mensaje={mensajes.plan(p.nombre)}
            class:list={['btn', p.destacado ? 'btn--light' : 'btn--primary']}
          >
            Consultá el valor
          </WaLink>
        </li>
      ))}
    </ul>

    <p class="planes__nota reveal">{planes.nota}</p>
  </div>
</section>

<style>
  .planes {
    display: grid;
    gap: 16px;
  }

  .plan {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr auto auto;
    gap: 16px;
    padding: 24px 20px 20px;
    background: var(--surface);
    border: 1px solid var(--rule-strong);
  }

  .plan--destacado {
    background: var(--gradient-ledger);
    color: #ffffff;
    border-color: #384ce3;
  }

  .plan__badge {
    justify-self: start;
    padding: 6px 8px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: var(--radius);
    font-size: 0.6875rem;
  }

  .plan:not(.plan--destacado) {
    grid-template-rows: auto auto 1fr auto auto;
  }

  .plan__name {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 500;
    line-height: 1;
  }

  .plan__resumen {
    color: var(--muted);
  }

  .plan--destacado .plan__resumen {
    color: rgba(255, 255, 255, 0.82);
  }

  .plan__list {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }

  .plan--destacado .plan__list {
    border-top-color: rgba(255, 255, 255, 0.24);
  }

  .plan__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
  }

  .plan__list :global(svg) {
    margin-top: 3px;
    color: var(--accent);
  }

  .plan--destacado .plan__list :global(svg) {
    color: #c4f0ff;
  }

  .plan__plazo {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 0.8125rem;
  }

  .plan__plazo span {
    color: var(--muted);
  }

  .plan--destacado .plan__plazo {
    border-top-color: rgba(255, 255, 255, 0.24);
  }

  .plan--destacado .plan__plazo span {
    color: rgba(255, 255, 255, 0.72);
  }

  .planes__nota {
    margin-top: 32px;
    padding-top: 20px;
    border-top: 1px solid var(--rule-strong);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-style: italic;
    line-height: 1.3;
  }

  @media (min-width: 900px) {
    .planes {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }

    .plan {
      padding: 32px 28px 28px;
    }
  }
</style>
