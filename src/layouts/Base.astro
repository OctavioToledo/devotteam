---
import '@fontsource-variable/cormorant-garamond/wght.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import { site, contacto, instagramLink, waLink } from '../config/site';
import { hero, planes } from '../data/contenido';
import { faq } from '../data/faq';
import { equipo } from '../data/equipo';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const home = new URL('/', Astro.site).href;
const id = (frag: string) => `${home}#${frag}`;
// Google Search Console: site.googleVerification, o la variable PUBLIC_GOOGLE_SITE_VERIFICATION en Vercel.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || site.googleVerification;

// Datos estructurados para Google: empresa, sitio, página, servicios y preguntas frecuentes. Sin precios.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': id('organizacion'),
      name: site.name,
      alternateName: site.firma,
      description: site.description,
      slogan: hero.titulo,
      url: home,
      logo: { '@type': 'ImageObject', url: new URL('/apple-touch-icon.png', Astro.site).href, width: 180, height: 180 },
      image: ogImage.href,
      email: contacto.email,
      telephone: `+${contacto.whatsapp}`,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: `+${contacto.whatsapp}`,
        email: contacto.email,
        url: waLink(),
        availableLanguage: 'es',
        areaServed: 'AR',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.ciudad,
        addressRegion: site.provincia,
        addressCountry: 'AR',
      },
      areaServed: [
        { '@type': 'City', name: site.ciudad },
        { '@type': 'State', name: site.provincia },
        { '@type': 'Country', name: site.pais },
      ],
      founder: { '@type': 'Person', name: equipo[0].nombre, url: contacto.perfilTecnico },
      employee: equipo.map((p) => ({ '@type': 'Person', name: p.nombre, jobTitle: p.rol, description: p.bio })),
      knowsAbout: ['Desarrollo web', 'Catálogos online', 'Pedidos por WhatsApp', 'Páginas web para emprendedores'],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Planes de páginas web',
        itemListElement: planes.items.map((pl) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: `Página web plan ${pl.nombre}`,
            description: `${pl.resumen} ${pl.incluye.join('. ')}.`,
            serviceType: 'Diseño y desarrollo de páginas web',
            provider: { '@id': id('organizacion') },
          },
        })),
      },
      sameAs: [contacto.googleBusiness, contacto.perfilTecnico, instagramLink()].filter(Boolean),
    },
    {
      '@type': 'WebSite',
      '@id': id('sitio'),
      url: home,
      name: site.name,
      inLanguage: 'es-AR',
      publisher: { '@id': id('organizacion') },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#pagina`,
      url: canonical.href,
      name: site.title,
      description: site.description,
      inLanguage: 'es-AR',
      isPartOf: { '@id': id('sitio') },
      about: { '@id': id('organizacion') },
      primaryImageOfPage: ogImage.href,
    },
    {
      '@type': 'FAQPage',
      '@id': id('preguntas'),
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.pregunta,
        acceptedAnswer: { '@type': 'Answer', text: f.respuesta },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="es-AR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content={site.firma} />
    <meta name="geo.region" content="AR-M" />
    <meta name="geo.placename" content={site.ciudad} />
    <meta name="format-detection" content="telephone=no" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta name="theme-color" content="#09234f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#060d1a" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content="Devott · Tu catálogo online, con pedidos directo a tu WhatsApp" />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Devott: páginas web para emprendedores, con pedidos por WhatsApp" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Devott · Tu catálogo online, con pedidos directo a tu WhatsApp" />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Aplica el tema guardado antes de pintar, para evitar el parpadeo. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        try {
          var t = localStorage.getItem('devott-tema');
          if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
